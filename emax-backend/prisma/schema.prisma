generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id         Int     @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String  @unique
  phone      String  @unique
  password   String
  role       Role    @default(CUSTOMER)
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)
shopName   String?
  location   String?
  shopLogo   String?
  shopBanner String?
  shopDescription String?
  trustBadges String @default("[]")

  // Business location details
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  country       String?
  postalCode    String?

  // Deactivation tracking
  deactivatedReason String?

  resetToken       String?
  resetTokenExpiry DateTime?

  // User preferences
  notificationPrefs String @default("{\"orderUpdates\":true,\"promotions\":true,\"newsletter\":false,\"paymentAlerts\":true,\"wishlistAlerts\":false}")
  language          String @default("en")
  currency          String @default("KES")
  timezone          String @default("Africa/Nairobi")

  products             Product[]
  reviews              ProductReview[]
  orders               Order[]
  cart                 Cart?
  wishlist             Wishlist?
  addresses            CustomerAddress[]
  notifications        UserNotification[]
  createdNotifications Notification[]     @relation("CreatedNotifications")
  coupons              UserCoupon[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  FlashSale    FlashSale[]
  BulkDiscount BulkDiscount[]
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id   Int     @id @default(autoincrement())
  name String  @unique
  logo String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  description String

  price Float

  stock Int @default(0)

  thumbnail String

  discount Int @default(0)

  featured Boolean @default(false)

  active Boolean @default(true)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  brandId Int
  brand   Brand @relation(fields: [brandId], references: [id])

  images        ProductImage[]
  reviews       ProductReview[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  FlashSaleProduct    FlashSaleProduct[]
  BulkDiscountProduct BulkDiscountProduct[]
}

model ProductImage {
  id Int @id @default(autoincrement())

  image String

  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id Int @id @default(autoincrement())

  rating Int

  comment String

  productId Int

  userId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Order {
  id Int @id @default(autoincrement())

  orderNumber String @unique

  totalAmount Float

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  userId Int

  user User @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model OrderItem {
  id Int @id @default(autoincrement())

  quantity Int

  price Float

  orderId Int

  productId Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model Cart {
  id Int @id @default(autoincrement())

  userId Int @unique

  user User @relation(fields: [userId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model CartItem {
  id Int @id @default(autoincrement())

  quantity Int @default(1)

  cartId Int

  productId Int

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model Wishlist {
  id Int @id @default(autoincrement())

  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id Int @id @default(autoincrement())

  wishlistId Int

  productId Int

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId])
}

enum ZoneType {
  LOCAL
  REGIONAL
  INTERNATIONAL
}

enum ZoneStatus {
  ACTIVE
  INACTIVE
}

model ShippingZone {
  id            Int        @id @default(autoincrement())
  name          String
  regions       String
  fee           Float
  estimatedDays String
  zoneType      ZoneType   @default(LOCAL)
  status        ZoneStatus @default(ACTIVE)
  freeThreshold Float      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingSettings {
  id            Int   @id @default(autoincrement())
  defaultFee    Float @default(350)
  freeThreshold Float @default(5000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerAddress {
  id        Int     @id @default(autoincrement())
  label     String  @default("Home")
  firstName String
  lastName  String
  phone     String
  county    String
  town      String
  address   String
  landmark  String?
  isDefault Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_addresses")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id             Int                @id @default(autoincrement())
  code           String             @unique
  description    String?
  discountType   CouponDiscountType @default(PERCENTAGE)
  discountValue  Float
  minOrderAmount Float              @default(0)
  maxUsage       Int                @default(100)
  usedCount      Int                @default(0)
  expiresAt      DateTime?
  isActive       Boolean            @default(true)

  users UserCoupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserCoupon {
  id       Int      @id @default(autoincrement())
  userId   Int
  couponId Int
  usedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@map("user_coupons")
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum NotificationTarget {
  ALL
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

model Notification {
  id          Int                @id @default(autoincrement())
  title       String
  message     String
  type        NotificationType   @default(INFO)
  target      NotificationTarget @default(ALL)
  createdById Int
  createdBy   User               @relation("CreatedNotifications", fields: [createdById], references: [id])

  users UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNotification {
  id             Int       @id @default(autoincrement())
  userId         Int
  notificationId Int
  isRead         Boolean   @default(false)
  readAt         DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@map("user_notifications")
}

enum FlashSaleStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model FlashSale {
  id                 Int             @id @default(autoincrement())
  title              String
  description        String?
  discountPercentage Float
  startDate          DateTime
  endDate            DateTime
  status             FlashSaleStatus @default(SCHEDULED)
  isActive           Boolean         @default(true)

  sellerId Int
  seller   User @relation(fields: [sellerId], references: [id])

  products FlashSaleProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("flash_sales")
}

model FlashSaleProduct {
  id            Int    @id @default(autoincrement())
  discountPrice Float?

  flashSaleId Int
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([flashSaleId, productId])
  @@map("flash_sale_products")
}

enum BulkDiscountStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model BulkDiscount {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      BulkDiscountStatus @default(SCHEDULED)
  isActive    Boolean            @default(true)

  sellerId Int
  seller   User @relation(fields: [sellerId], references: [id])

  tiers    BulkDiscountTier[]
  products BulkDiscountProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bulk_discounts")
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model BulkDiscountTier {
  id            Int          @id @default(autoincrement())
  minQuantity   Int
  maxQuantity   Int
  discountType  DiscountType
  discountValue Float

  bulkDiscountId Int
  bulkDiscount   BulkDiscount @relation(fields: [bulkDiscountId], references: [id], onDelete: Cascade)

  @@map("bulk_discount_tiers")
}

model BulkDiscountProduct {
  id Int @id @default(autoincrement())

  bulkDiscountId Int
  bulkDiscount   BulkDiscount @relation(fields: [bulkDiscountId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([bulkDiscountId, productId])
  @@map("bulk_discount_products")
}

model StoreSettings {
  id Int @id @default(autoincrement())

  // General
  storeName    String @default("E-Max Store")
  tagline      String @default("Your Premium Shopping Destination")
  supportEmail String @default("support@emaxstore.com")
  supportPhone String @default("+254 700 123 456")
  address      String @default("123 Kenyatta Avenue, Nairobi, Kenya")
  currency     String @default("KES")
  timezone     String @default("Africa/Nairobi")

  // Appearance
  logo            String  @default("")
  favicon         String  @default("")
  primaryColor    String  @default("#6366f1")
  secondaryColor  String  @default("#8b5cf6")
  accentColor     String  @default("#f59e0b")
  backgroundColor String  @default("#f5f6fa")
  darkMode        Boolean @default(false)

  // Social Media
  facebookUrl  String @default("")
  twitterUrl   String @default("")
  instagramUrl String @default("")
  tiktokUrl    String @default("")
  youtubeUrl   String @default("")
  linkedinUrl  String @default("")

  // Custom Code
  customCss    String @default("")
  customJs     String @default("")
  customHeader String @default("")
  customFooter String @default("")

  // Email SMTP
  smtpHost      String @default("")
  smtpPort      Int    @default(587)
  smtpUser      String @default("")
  smtpPass      String @default("")
  smtpFromEmail String @default("")
  smtpFromName  String @default("")

  // Payment - stored as JSON string
  paymentMethods String @default("[]")

  // Notifications - stored as JSON string
  notifications String @default("[]")

  // SEO
  metaTitle         String  @default("E-Max Store - Premium Shopping")
  metaDescription   String  @default("Discover the best deals on electronics, fashion, home goods at E-Max Store.")
  googleAnalyticsId String  @default("")
  maintenanceMode   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
